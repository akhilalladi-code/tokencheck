{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#0B5D4A" },
      "primary-strong": { "$value": "#004638" },
      "accent": { "$value": "#ED841E" },
      "surface": { "$value": "#FFFFFF" },
      "surface-soft": { "$value": "#DDEBE5" },
      "alias-example": { "$value": "{color.brand.primary}" }
    },
    "text": {
      "on-light": { "$value": "#17211D" },
      "on-dark": { "$value": "#FFFFFF" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" }
  },
  "legacyTokens": {
    "Brand_Primary": { "type": "color", "value": "#0B5D4A" },
    "broken-alias": { "type": "color", "value": "{color.brand.missing}" }
  }
}
